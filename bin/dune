(rule
 (targets z3)
 (action
  (progn
   (run
    wget
    --tries=5
    --timeout=30
    --waitretry=10
    https://github.com/Z3Prover/z3/releases/download/z3-4.15.2/z3-4.15.2-x64-glibc-2.39.zip
    -O
    z3.zip)
   (run unzip -o -q z3.zip)
   (run mv ./z3-4.15.2-x64-glibc-2.39/bin/z3 ./z3))))

(rule
 (targets ostrich2 target ostrich-client)
 (action
  (progn
   (run
    wget
    --tries=5
    --timeout=30
    --waitretry=10
    https://github.com/uuverifiers/ostrich/releases/download/v2.0.1/ostrich-2.0.1.zip
    -O
    ostrich.zip)
   (run unzip -o -q ostrich.zip)
   (run cp -f -r ./ostrich-2.0.1/ostrich ./ostrich2)
   (run cp -f -r ./ostrich-2.0.1/ostrich-client ./ostrich-client)
   (run cp -f -r ./ostrich-2.0.1/target ./target)
   (run chmod +x ./ostrich2)
   ;
   )))
