# Evaluation image for the TACAS 2027 paper: the static Chrobelias release
# binary, the five solvers it is compared with, the benchmarks and the scripts.
# There is no OCaml toolchain in the image; Chrobelias is the static binary of
# the GitHub release named by CHRO_VERSION.
#
#   git submodule update --init benchmarks/chrobelias
#   docker build -f Dockerfile.eval -t chrobelias-eval:v1.2.0 .
#   docker run --rm -v "$PWD/results:/Chrobelias/results" \
#     -v "$PWD/stats:/Chrobelias/stats" chrobelias-eval:v1.2.0
FROM ubuntu:24.04
ARG CHRO_VERSION=v1.2.0
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates wget unzip parallel time util-linux python3 python3-matplotlib \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /Chrobelias
COPY . /Chrobelias
RUN mkdir -p release _build/default/bin && cd _build/default/bin \
 && wget -q https://github.com/ffrohn/swine-z3/releases/download/v0.2.0/swine-z3-linux-static-92ceb6ce8207f790ae2c6c5d43d2368a96192318.zip -O swine.zip \
 && unzip -q swine.zip && cp swine-z3 swine && chmod +x swine \
 && wget -q https://github.com/cvc5/cvc5/releases/download/cvc5-1.4.0/cvc5-Linux-x86_64-static.zip -O cvc5.zip \
 && unzip -q cvc5.zip && cp cvc5-Linux-x86_64-static/bin/cvc5 cvc5 && chmod +x cvc5 \
 && wget -q https://github.com/VeriFIT/z3-noodler/releases/download/v1.7.0/z3-noodler-ubuntu-24.04-x86_64-static-libz3 -O z3-noodler \
 && chmod +x z3-noodler \
 && wget -q https://github.com/Z3Prover/z3/releases/download/z3-5.1.0/z3-5.1.0-x64-glibc-2.39.zip -O z3.zip \
 && unzip -q z3.zip && cp z3-5.1.0-x64-glibc-2.39/bin/z3 z3 && chmod +x z3 \
 && wget -q https://github.com/uuverifiers/ostrich/releases/download/v2.1/ostrich-2.1-x64-linux-static.zip -O ostrich.zip \
 && unzip -q ostrich.zip && cp ostrich-2.1-x64-linux-static/ostrich ostrich2 \
 && cp -r ostrich-2.1-x64-linux-static/target target && chmod +x ostrich2 \
 && rm -rf *.zip swine-z3 cvc5-Linux-x86_64-static z3-5.1.0-x64-glibc-2.39 ostrich-2.1-x64-linux-static
RUN wget -q https://github.com/Chrobelias/Chrobelias/releases/download/${CHRO_VERSION}/chro -O release/chro \
 && chmod +x release/chro
CMD ["/Chrobelias/bench.sh"]
