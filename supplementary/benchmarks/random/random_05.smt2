
(set-logic QF_SLIA)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun u () Int)
(assert
  (and
    (> x 0)
    (> z 0)
    (> w 0)
    (int.v x y)
    (int.v z w)
    (int.v w u)
    (= (+ (* 7 x) (* 3 z)) (+ w u))
    (<= (* 5 y) (+ (* 2 z) w))
  )
)
(check-sat)
