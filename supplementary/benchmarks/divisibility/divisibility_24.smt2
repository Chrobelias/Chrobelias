
(set-logic QF_SLIA)
(declare-fun a () Int)
(declare-fun b () Int)
(declare-fun c () Int)
(declare-fun d () Int)
(declare-fun x1 () Int)
(declare-fun y1 () Int)
(declare-fun x2 () Int)
(declare-fun y2 () Int)
(assert
  (and
    (int.v (- (* 2 a) (* 3 b)) x1)
    (int.v (+ (* 5 c) (* 5 d)) y1)
    (<= x1 y1)
    (int.v (+ a (+ b (+ c d))) x2)
    (int.v (+ (- a d) 3) y2)
    (<= x2 y2)
  )
)
(check-sat)
