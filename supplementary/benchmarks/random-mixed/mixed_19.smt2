
(set-logic QF_SLIA)
(declare-fun A () Int)
(declare-fun B () Int)
(declare-fun C () String)
(declare-fun E () Int)
(assert (str.in_re C (re.++ (str.to_re "1") (re.++ (re.+ (str.to_re "0")) (str.to_re "1")))))
(assert (<= 100 (str.to_int C)))
(assert (int.v (+ (* 8 (str.to_int C)) (* (- 4) E)) A))
(assert (int.v (+ (* 5 E) (- 75)) B))
(assert (<= A B))
(check-sat)
