
(set-logic QF_SLIA)
(declare-fun a () Int)
(declare-fun b () Int)
(declare-fun c () Int)
(declare-fun d () Int)
(declare-fun x1 () Int)
(declare-fun y1 () Int)
(declare-fun x2 () Int)
(declare-fun y2 () Int)
(assert
  (and
    (int.v (+ (- (* 11 a) (* 5 b)) 2) x1)
    (int.v (+ (* 3 c) d) y1)
    (<= x1 y1)
    (int.v (+ a (+ b (+ c d))) x2)
    (int.v (- (* 4 a) (* 4 c)) y2)
    (<= x2 y2)
  )
)
(check-sat)
