
(set-logic QF_SLIA)
(declare-fun a () Int)
(declare-fun b () Int)
(declare-fun c () Int)
(declare-fun x1 () Int)
(declare-fun y1 () Int)
(declare-fun x2 () Int)
(declare-fun y2 () Int)
(declare-fun x3 () Int)
(declare-fun y3 () Int)
(assert
  (and
    (int.v (- (* 9 a) (* 3 b)) x1)
    (int.v (+ (* 4 c) 1) y1)
    (<= x1 y1)
    (int.v (+ a (+ b c)) x2)
    (int.v (- (* 2 a) (* 6 c)) y2)
    (<= x2 y2)
    (int.v a x3)
    (int.v b y3)
    (<= x3 y3)
  )
)
(check-sat)
