
(set-logic QF_SLIA)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(declare-fun u () Int)
(declare-fun vv () Int)
(assert
  (and
    (> x 0)
    (> z 0)
    (> u 0)
    (int.v x y)
    (int.v z w)
    (int.v u vv)
    (<= (+ (* 2 x) z) (* 7 u))
    (<= (+ y w) u)
    (<= x w)
    (<= z vv)
  )
)
(check-sat)
